# Copy to `.env` (which is gitignored) and fill in. All optional.

# --- Classifier backend -------------------------------------------------
# auto | ollama | claude | offline
RECOVERY_AGENT_BACKEND=auto
# Anthropic API key — only needed for the "claude" backend
# ANTHROPIC_API_KEY=sk-ant-...
CLASSIFIER_MODEL=claude-sonnet-5
# Local model name for the "ollama" backend
OLLAMA_MODEL=llama3.1:8b

# --- Razorpay test mode ------------------------------------------------
# From dashboard.razorpay.com  ->  Settings  ->  API Keys  (in Test Mode)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
